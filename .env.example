# Mailcow API — required
# The origin of your Mailcow UI, no trailing slash.
MAILCOW_BASE_URL=https://mail.example.com
# System > Configuration > Access > API. Create a READ-WRITE key and add this
# machine's public IP to the key's allowed-IP list, or every call returns 401.
MAILCOW_API_KEY=

# Mail host SSH — optional, enables the mailsrv_* tools and deeper log history.
MAIL_SSH_HOST=
MAIL_SSH_USER=root
MAIL_SSH_PORT=22
# Use a key. Password auth works but is second choice.
# Use an ABSOLUTE path. Must be an OpenSSH-format key — a PuTTY .ppk will not load.
#   Windows: C:\Users\you\.ssh\id_ed25519   (single backslashes here; double them in
#            claude_desktop_config.json, which is JSON)
#   macOS/Linux: /home/you/.ssh/id_ed25519
MAIL_SSH_KEY_PATH=
# MAIL_SSH_KEY_PASSPHRASE=
# MAIL_SSH_PASSWORD=
